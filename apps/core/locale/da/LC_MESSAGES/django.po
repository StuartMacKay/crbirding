#: templates/admin/core/location_import.html:7
msgid ""
"\n"
"    <h2>CSV format</h2>\n"
"    <p>One row per location.</p>\n"
"    <ul>\n"
"      <li>name (required)</li>\n"
"      <li>region, country (both required; either the EURING code or the "
"display\n"
"        label works for each -- country narrows which region a name means, "
"since\n"
"        region labels aren't unique across countries)</li>\n"
"      <li>latitude (decimal; required)</li>\n"
"      <li>longitude (decimal; required)</li>\n"
"      <li>accuracy (metres; optional)</li>\n"
"      <li>notes (optional)</li>\n"
"    </ul>\n"
"\n"
"    <p>A row matching an existing location by name and region (matching is\n"
"      case-insensitive) is skipped rather than creating a duplicate; its "
"coordinates\n"
"      are left as they are. A row matching none creates a new location.</p>\n"
"\n"
"    <p>Coordinates are saved to 4 decimal places, giving a positional "
"accuracy of\n"
"      around 10m.</p>\n"
"  "
msgstr ""

#: templates/admin/core/location_import.html:32
#: templates/admin/core/observation_import.html:45
#: templates/admin/core/project_import.html:27
#: templates/admin/core/rule_import.html:26
msgid "Import"
msgstr ""

#: templates/admin/core/observation_import.html:7
msgid ""
"\n"
"    <h2>CSV format</h2>\n"
"    <p>One row per observation.</p>\n"
"    <ul>\n"
"      <li>species (required; euring code, code, or name)</li>\n"
"      <li>age, sex (both optional, default to unknown; either the EURING "
"code\n"
"        or the display label works for each, e.g. \"9\" or \"4CY\", \"M\" or "
"\"Male\")</li>\n"
"      <li>date (required; YYYY-MM-DD)</li>\n"
"      <li>time (optional; HH:MM)</li>\n"
"      <li>location, region, country (all required; region and country narrow "
"which\n"
"        location a name means -- either the EURING code or the display label "
"works\n"
"        for region/country. Creates a new location, from this row's own "
"latitude,\n"
"        longitude, and accuracy, if none matches all three)</li>\n"
"      <li>latitude (decimal; required to add a new location, otherwise "
"optional)</li>\n"
"      <li>longitude (decimal; required to add a new location, otherwise "
"optional)</li>\n"
"      <li>accuracy (metres; required to add a new location, otherwise "
"optional)</li>\n"
"      <li>observer (required; the observer's name -- created if none "
"matches)</li>\n"
"      <li>notes (optional)</li>\n"
"      <li>left_above, left_below, left_wing, nasal_saddle, neck_collar,\n"
"        right_above, right_below, right_wing (one column per tag position;\n"
"        each optional, but at least one must be present and, for a given\n"
"        row, at least one must have a value)</li>\n"
"    </ul>\n"
"\n"
"    <p>Each position column holds the tag(s) worn at that position only,\n"
"      e.g. a right_below of \"BW(A123)d\" or, for two rings stacked at the\n"
"      same position read top to bottom, \"O,Y\".</p>\n"
"\n"
"    <p>The letter 'u', 'd', or 'h' after the closing bracket indicates the\n"
"      direction of the code when read from left to right.</p>\n"
"\n"
"    <p>The coordinates override those for the location, for this sighting "
"only.\n"
"      Values are saved to 4 decimal place, giving a positional accuracy of "
"10m.</p>\n"
"  "
msgstr ""

#: templates/admin/core/project_import.html:7
msgid ""
"\n"
"    <h2>CSV format</h2>\n"
"    <p>One row per project.</p>\n"
"    <ul>\n"
"      <li>name (required)</li>\n"
"      <li>coordinator (required)</li>\n"
"      <li>country (required; either the EURING code or the display label)</"
"li>\n"
"      <li>contact (optional; the email address observations should be sent "
"to)</li>\n"
"      <li>submit (optional; the website where observations should be "
"submitted)</li>\n"
"      <li>site (optional; the website describing the project)</li>\n"
"      <li>description (optional)</li>\n"
"    </ul>\n"
"\n"
"    <p>There's only ever one project per country -- a row naming a country "
"that\n"
"      already has one is skipped rather than creating a duplicate.</p>\n"
"  "
msgstr ""

#: templates/admin/core/rule_import.html:7
msgid ""
"\n"
"    <h2>CSV format</h2>\n"
"    <p>One row per rule.</p>\n"
"    <ul>\n"
"      <li>species (required; euring code, code, or name)</li>\n"
"      <li>position (required; euring code or the display label)</li>\n"
"      <li>regex (required; a valid regular expression)</li>\n"
"      <li>coordinator, project (identify the project the rule belongs to; "
"at\n"
"        least one of the two is required per row -- if both are given, they\n"
"        must name the same project)</li>\n"
"    </ul>\n"
"\n"
"    <p>A row matching an existing rule's species, position, regex, and "
"project\n"
"      exactly is skipped rather than creating a duplicate.</p>\n"
"  "
msgstr ""

